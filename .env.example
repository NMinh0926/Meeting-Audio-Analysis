# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (metadata). compose builds DATABASE_URL from these.
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=meeting

# --- Object storage for original recordings (S3 API: SeaweedFS in compose; S3/R2 by configuration).
S3_ACCESS_KEY=change_me_access_key
S3_SECRET_KEY=change_me_secret_key_min_8_chars
S3_BUCKET=meetings

# --- Working directory for intermediate audio (inside the container)
TEMP_DIR=data/temp

# --- Models. compose sets DEVICE=cuda and COMPUTE_TYPE=int8_float16 for the GPU;
# outside Docker use DEVICE=cpu and COMPUTE_TYPE=int8.
WHISPER_MODEL=large-v3-turbo
WHISPER_HALLUCINATION_SILENCE_SECONDS=2
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- Hugging Face (accept the pyannote model terms on huggingface.co first)
HF_TOKEN=your_huggingface_token_here

# --- Uploads and worker
MAX_UPLOAD_MB=500
WORKER_POLL_SECONDS=2

# --- Gender recognition (per speaker)
GENDER_CHUNK_SECONDS=10
GENDER_SECONDS_PER_SPEAKER=60
GENDER_MALE_THRESHOLD=0.2
GENDER_MIN_CONFIDENCE=0.55

# --- Emotion per turn: voice model on the GPU (DEVICE), text model on the CPU
EMOTION_TEXT_DEVICE=cpu
EMOTION_VOICE_WEIGHT=0.6
EMOTION_MIN_MARGIN=0.15
